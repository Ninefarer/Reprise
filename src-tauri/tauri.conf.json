{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reprise",
  "version": "3.3.3",
  "identifier": "com.reprise.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reprise",
        "width": 1180,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "create": false,
        "visible": false
      },
      {
        "label": "capture",
        "title": "Capture an intention",
        "url": "index.html?capture=1",
        "width": 560,
        "height": 200,
        "resizable": false,
        "visible": false,
        "create": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "skipTaskbar": true,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ninefarer/Reprise/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEODAzMzZCNEE0RjQwRDcKUldUWFFFOUthek9BN1VPSm1lLysrM0MzcjJGcEMySlFDdVJXRXcyZklqN1FnV3dCcVYvNWFTVUwK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Later should actually arrive.",
    "category": "Productivity",
    "icon": [
      "icons/stable/32x32.png",
      "icons/stable/128x128.png",
      "icons/stable/128x128@2x.png",
      "icons/stable/icon.png",
      "icons/stable/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/stable/icon.ico",
        "uninstallerIcon": "icons/stable/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  }
}
